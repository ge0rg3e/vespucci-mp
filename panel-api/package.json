{
	"name": "panel-api",
	"version": "1.4.0",
	"description": "Back-end API made with Express.js",
	"scripts": {
		"serve": "node index.js",
		"start": "nodemon --watch \"src/**\"  --ext \"ts,json\"  --exec node ./dist/index.js",
		"dev": "rollup -w -c",
		"build": "rollup -c --configProduction",
		"lint": "eslint ./",
		"lint-watch": "nodemon --watch ./ --exec npm run lint && node",
		"rebase": "git checkout master && git pull --rebase upstream master && git push --force-with-lease origin master",
		"modules": "git submodule update --init --recursive && git submodule update --remote"
	},
	"author": "Vatto",
	"contributors": [
		"Ge0rg3e"
	],
	"license": "ISC",
	"dependencies": {
		"@sendgrid/mail": "7.7.0",
		"@vmp/i18n": "github:vespucci-mp/i18n#build",
		"axios": "0.25.0",
		"body-parser": "1.20.2",
		"colorette": "2.0.16",
		"cookie-session": "2.0.0",
		"cors": "2.8.5",
		"dotenv": "16.0.1",
		"express": "4.18.1",
		"lodash": "4.17.21",
		"memjs": "1.3.1",
		"moment": "2.29.1",
		"mysql2": "2.3.3",
		"node-cron": "^3.0.2",
		"sequelize": "6.15.1",
		"sha256": "0.2.0",
		"yup": "0.32.11"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "21.0.1",
		"@rollup/plugin-json": "4.1.0",
		"@rollup/plugin-node-resolve": "13.0.6",
		"@rollup/plugin-replace": "3.0.1",
		"@swc/core": "1.2.204",
		"@types/cookie-session": "2.0.44",
		"@types/cors": "^2.8.12",
		"@types/express": "4.17.13",
		"@types/lodash": "4.14.182",
		"@types/memjs": "1.3.0",
		"@types/node": "17.0.15",
		"@types/node-cron": "^3.0.7",
		"@types/sha256": "0.2.0",
		"@typescript-eslint/eslint-plugin": "5.30.7",
		"@typescript-eslint/parser": "5.30.7",
		"fs-jetpack": "5.0.0",
		"nodemon": "2.0.20",
		"path": "0.12.7",
		"prettier": "2.5.1",
		"read-pkg": "7.0.0",
		"rollup": "2.67.1",
		"rollup-plugin-swc3": "0.1.4",
		"rollup-plugin-tsconfig-paths": "1.1.6",
		"ts-node-dev": "2.0.0",
		"typescript": "4.4.4"
	},
	"prettier": {
		"$schema": "http://json.schemastore.org/prettierrc",
		"endOfLine": "lf",
		"printWidth": 200,
		"quoteProps": "as-needed",
		"semi": true,
		"singleQuote": true,
		"tabWidth": 4,
		"trailingComma": "none",
		"useTabs": true,
		"overrides": [
			{
				"files": "*.yml",
				"options": {
					"tabWidth": 2,
					"useTabs": false
				}
			}
		]
	}
}
